{
  "name": "usage-console",
  "version": "0.1.0",
  "description": "Local quota and token-usage console for Codex, Claude, Grok, and Antigravity.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "usage-console": "./bin/usage-console.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmazingUmi/Usage_Console.git"
  },
  "homepage": "https://github.com/AmazingUmi/Usage_Console#readme",
  "bugs": {
    "url": "https://github.com/AmazingUmi/Usage_Console/issues"
  },
  "keywords": [
    "usage",
    "quota",
    "codex",
    "claude",
    "cli"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && pnpm build:client && pnpm build:server",
    "start": "node bin/usage-console.js",
    "server": "tsx src/server/index.ts",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "node scripts/test.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:pack": "node scripts/release.mjs pack"
  },
  "dependencies": {
    "express": "^4.21.2",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
