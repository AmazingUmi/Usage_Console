+++ b/src/client/styles/index.css
@@ -0,0 +1,11 @@
+/*
+ * Usage Console — iOS frosted-glass design system.
+ * Load order matters: tokens → base → glass (surfaces & controls) → feature layers.
+ */
+@import "./tokens.css";
+@import "./base.css";
+@import "./glass.css";
+@import "./layout.css";
+@import "./quota.css";
+@import "./usage.css";
+@import "./a11y.css";
diff --git a/src/client/styles/layout.css b/src/client/styles/layout.css
new file mode 100644
index 0000000..68fa813
--- /dev/null
+++ b/src/client/styles/layout.css
@@ -0,0 +1,49 @@
+/* ===== App frame: header capsule, hero, section rhythm ===== */
+.app-header {
+  position: sticky; top: 12px; z-index: 20;
+  width: calc(100% - 2 * var(--gutter)); max-width: 1176px; margin: 14px auto 0;
+  border-radius: 32px;
+}
+.header-inner { display: flex; align-items: center; gap: 12px; min-height: 60px; padding: 0 14px 0 12px; }
+.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--text); font-size: 16px; font-weight: 700; letter-spacing: -.01em; text-decoration: none; white-space: nowrap; }
+.brand-mark {
+  display: grid; place-items: center; width: 36px; height: 36px; border-radius: 11px;
+  background: linear-gradient(160deg, var(--accent-hi), var(--accent)); color: var(--accent-contrast);
+  box-shadow: inset 0 1px 0 rgb(255 255 255 / 40%); font: 22px/1 Georgia, serif;
+}
+.main-nav { margin-right: auto; }
+.header-inner .button-primary { height: 38px; padding: 0 18px; }
+
+/* Connection dot: green = live, amber = connecting, red = offline. */
+.connection-status {
+  --dot: #1f9d62;
+  flex: none; width: 10px; height: 10px; margin: 0 6px; border-radius: 50%;
+  background: var(--dot); box-shadow: 0 0 0 3px color-mix(in srgb, var(--dot) 25%, transparent);
+  animation: breathe 2.8s ease-in-out infinite;
+}
+.connection-status[data-state="connecting"] { --dot: #e8a23a; }
+.connection-status[data-state="offline"] { --dot: var(--danger); animation: none; }
+@keyframes breathe { 50% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--dot) 14%, transparent); } }
+
+.shell { max-width: 1240px; margin: 0 auto; padding: 28px var(--gutter) 24px; }
+.hero { margin-bottom: 8px; }
+.subtitle { margin-top: 6px; color: var(--muted); font-size: 14px; }
+
+.section { margin-top: 40px; }
+.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
+.subsection-heading { margin-bottom: 12px; }
+
+.app-footer { max-width: 1240px; margin: 0 auto; padding: 24px var(--gutter) 48px; color: var(--muted); font-size: 12px; text-align: center; }
+
+@media (max-width: 760px) {
+  .header-inner { flex-wrap: wrap; row-gap: 8px; padding: 10px 14px; }
+  .brand { margin-right: auto; }
+  .main-nav { order: 9; width: 100%; margin: 0; }
+  .main-nav a { flex: 1; justify-content: center; }
+}
+@media (max-width: 480px) {
+  .refresh-label { display: none; }
+  .header-inner .button-primary { width: 38px; padding: 0; }
+  .section-heading { flex-wrap: wrap; }
+  html { scroll-padding-top: 140px; }
+}
diff --git a/src/client/styles/quota.css b/src/client/styles/quota.css
new file mode 100644
index 0000000..47fb877
--- /dev/null
+++ b/src/client/styles/quota.css
@@ -0,0 +1,111 @@
+/* ===== Provider quota cards & battery gauges ===== */
+.provider-grid {
+  display: grid; grid-template-columns: repeat(var(--provider-columns), minmax(0, 1fr));
+  gap: 16px; align-items: stretch;   /* equal heights, incl. the unconfigured placeholder */
+}
+
+.panel.provider-card {
+  --pc: var(--gray);                  /* TSX sets --pc per provider */
+  display: flex; flex-direction: column; padding: 18px 18px 14px;
+  background: linear-gradient(155deg, color-mix(in srgb, var(--pc) 12%, transparent), transparent 62%), var(--fill-1);
+}
+.provider-card.is-empty { background: var(--fill-1); }
+
+/* Heading: icon | title+plan | status | help — the title can wrap but never collides with the tag. */
+.provider-heading {
+  position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto;
+  align-items: start; gap: 10px; margin-bottom: 14px;
+}
+.provider-heading > div { min-width: 0; }
+.provider-heading h3 {
+  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
+  font-size: 14px; line-height: 1.35; overflow-wrap: anywhere;
+}
+.provider-heading .hint { margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11.5px; }
+.provider-icon {
+  display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px;
+  background: color-mix(in srgb, var(--pc) 16%, transparent); color: var(--pc); font: 700 15px var(--mono);
+}
+.provider-heading .info-help { margin-top: 1px; }
+
+/* Gauge area grows to fill the card so footers line up across the row. */
+.quota-groups { flex: 1; display: flex; flex-direction: column; justify-content: center; }
+.gauge {
+  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 12px;
+  justify-items: center; align-items: start; padding: 4px 0 6px;
+}
+.gauge-count-1 { grid-template-columns: minmax(0, 1fr); }
+.gauge-count-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.is-empty .gauge { min-height: 170px; grid-template-columns: 1fr; align-items: center; }
+.quota-empty-note { text-align: center; }
+
+.gauge-row {
+  --bw: 64px; --bh: 112px; --fill: var(--pc); --sep: rgb(255 255 255 / 60%);
+  display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 0; text-align: center;
+}
+.gauge-count-1 .gauge-row { --bw: 84px; --bh: 132px; }   /* single window: bigger, centred */
+.gauge-count-3 .gauge-row { --bw: 54px; --bh: 100px; }
+.gauge-head { color: var(--muted); font-size: 12.5px; }
+
+/* Battery: soft glow behind, ticks at 25/50/75, fill brightens at the top edge. */
+.battery-stage { position: relative; display: grid; place-items: center; padding-top: 10px; }
+.battery-stage::before {
+  content: ""; position: absolute; left: 50%; bottom: 0; transform: translateX(-50%);
+  width: calc(var(--bw) + 60px); height: calc(var(--v) * 1% + 40px);
+  background: radial-gradient(closest-side at 50% 100%, color-mix(in srgb, var(--fill) 45%, transparent), transparent);
+  filter: blur(14px); opacity: .7; pointer-events: none;
+}
+.battery {
+  --r: calc(var(--bw) * .34);
+  position: relative; display: flex; align-items: flex-end; width: var(--bw); height: var(--bh); padding: 5px;
+  border: 2px solid color-mix(in srgb, var(--fill) 45%, transparent); border-radius: var(--r);
+  background: linear-gradient(180deg, rgb(255 255 255 / 45%), color-mix(in srgb, var(--fill) 8%, transparent));
+  box-shadow: inset 0 1px 0 rgb(255 255 255 / 70%), 0 8px 22px color-mix(in srgb, var(--fill) 20%, transparent);
+}
+.battery::before {   /* terminal cap */
+  content: ""; position: absolute; left: 50%; top: -9px; width: 36%; height: 7px; transform: translateX(-50%);
+  border-radius: 4px 4px 0 0; background: color-mix(in srgb, var(--fill) 45%, transparent);
+}
+.battery::after {    /* level ticks */
+  content: ""; position: absolute; inset: 5px; border-radius: calc(var(--r) - 7px); pointer-events: none;
+  background: linear-gradient(to top, transparent 24%, var(--sep) 24% 26%, transparent 26% 49%, var(--sep) 49% 51%, transparent 51% 74%, var(--sep) 74% 76%, transparent 76%);
+}
+.battery-fill {
+  display: block; width: 100%; border-radius: calc(var(--r) - 7px);
+  background: linear-gradient(180deg, color-mix(in srgb, var(--fill) 72%, #fff), var(--fill));
+  box-shadow: 0 0 20px color-mix(in srgb, var(--fill) 60%, transparent), inset 0 2px 0 rgb(255 255 255 / 45%);
+  transition: height .6s var(--ease);
+}
+.gauge-row[data-known="false"] .battery { border-style: dashed; }
+.gauge-row[data-known="false"] .battery-fill,
+.gauge-row[data-known="false"] .battery-stage::before { display: none; }
+
+.gauge-val { font-size: 28px; font-weight: 700; line-height: 1.1; letter-spacing: -.03em; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.gauge-count-1 .gauge-val { font-size: 34px; }
+.gauge-count-3 .gauge-val { font-size: 24px; }
+.gauge-val small { display: block; margin: 2px 0 0; color: var(--muted); font-size: 11.5px; font-weight: 450; letter-spacing: 0; line-height: 1.2; }
+.gauge-row[data-level="warning"] .gauge-val { color: var(--warning); }
+.gauge-row[data-level="low"] .gauge-val { color: var(--danger); }
+
+.gauge-reset {
+  display: inline-flex; align-items: center; gap: 5px; max-width: 100%; padding: 3px 11px 3px 9px;
+  border-radius: var(--r-pill); color: var(--muted); font-size: 11.5px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.4; white-space: nowrap;
+}
+.gauge-reset small { font-size: inherit; }
+.gauge-reset-icon { flex: none; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
+.gauge-row[data-level="warning"] .gauge-reset,
+.gauge-row[data-level="low"] .gauge-reset { color: var(--text); background: color-mix(in srgb, var(--fill) 14%, var(--fill-2)); border-color: color-mix(in srgb, var(--fill) 40%, transparent); }
+
+.provider-foot {
+  display: flex; align-items: center; justify-content: space-between; gap: 10px;
+  margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--edge);
+  color: var(--muted); font-size: 11.5px; font-variant-numeric: tabular-nums;
+}
+
+@media (prefers-color-scheme: dark) {
+  .gauge-row { --sep: rgb(14 20 28 / 55%); }
+  .battery {
+    background: linear-gradient(180deg, rgb(255 255 255 / 8%), color-mix(in srgb, var(--fill) 8%, transparent));
+    box-shadow: inset 0 1px 0 rgb(255 255 255 / 20%), 0 8px 22px color-mix(in srgb, var(--fill) 22%, transparent);
+  }
+}
diff --git a/src/client/styles/tokens.css b/src/client/styles/tokens.css
new file mode 100644
index 0000000..c35e018
--- /dev/null
+++ b/src/client/styles/tokens.css
@@ -0,0 +1,109 @@
+/*
+ * Design tokens. Raw colours, radii, blur and shadows live here and nowhere else.
+ *
+ * Glass is built from three fill levels on top of one mesh-gradient canvas:
+ *   --fill-1  cards and the header capsule   (most transparent, blurred)
+ *   --fill-2  chips, selects, buttons, tabs  (sits on a card, no extra blur)
+ *   --fill-3  popovers and pickers           (most opaque, blurred)
+ */
+:root {
+  color-scheme: light dark;
+  --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
+  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
+
+  /* text */
+  --text: #141a26;
+  --muted: #5a6578;
+
+  /* canvas */
+  --bg: #edf0f6;
+  --mesh-a: #cfe3f2;
+  --mesh-b: #dcd6f4;
+  --mesh-c: #c8ece6;
+
+  /* brand */
+  --accent: #0b8497;
+  --accent-hi: #2bb6c7;
+  --accent-hover: #08707f;
+  --accent-contrast: #fff;
+  --accent-soft: rgb(11 132 151 / 12%);
+
+  /* providers: OpenAI graphite · Claude terracotta · Grok ink · Antigravity azure */
+  --gray: #586272;
+  --chart-secondary: #cf6a43;
+  --grok: #252a33;
+  --agy: #2f7df4;
+
+  /* quota levels */
+  --warning: #c2700a;
+  --danger: #d92d3a;
+
+  /* glass */
+  --fill-1: rgb(255 255 255 / 52%);
+  --fill-2: rgb(255 255 255 / 74%);
+  --fill-3: rgb(255 255 255 / 90%);
+  --fill-inset: rgb(120 140 170 / 13%);
+  --fill-hover: rgb(120 140 170 / 16%);
+  --hairline: rgb(255 255 255 / 80%);
+  --stroke: rgb(255 255 255 / 62%);
+  --edge: rgb(90 110 150 / 22%);
+  --track: #dbe2ec;
+  --solid: #fff;
+  --solid-2: #f1f4f9;
+  --shadow-card: 0 8px 30px rgb(40 60 110 / 10%), 0 1px 2px rgb(40 60 110 / 8%);
+  --shadow-pop: 0 18px 48px rgb(20 30 60 / 22%);
+  --shadow-thumb: 0 1px 4px rgb(20 40 90 / 16%);
+  --blur: blur(24px) saturate(180%);
+  --blur-pop: blur(32px) saturate(180%);
+
+  /* shape & motion */
+  --r-card: 26px;
+  --r-inner: 18px;
+  --r-pill: 999px;
+  --ease: cubic-bezier(.32, .72, 0, 1);
+  --gutter: 32px;
+  --provider-columns: 4;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --text: #e9eef6;
+    --muted: #9ba8bc;
+    --bg: #0a0f16;
+    --mesh-a: #12394a;
+    --mesh-b: #2c2656;
+    --mesh-c: #0e3d3b;
+
+    --accent: #4cc9d8;
+    --accent-hi: #86e3ec;
+    --accent-hover: #86e3ec;
+    --accent-contrast: #04252b;
+    --accent-soft: rgb(76 201 216 / 16%);
+
+    --gray: #bcc4d1;
+    --chart-secondary: #f0a07a;
+    --grok: #e8ebf0;
+    --agy: #6aa6ff;
+    --warning: #f5b84a;
+    --danger: #f87171;
+
+    --fill-1: rgb(30 38 54 / 55%);
+    --fill-2: rgb(255 255 255 / 9%);
+    --fill-3: rgb(28 36 50 / 92%);
+    --fill-inset: rgb(255 255 255 / 7%);
+    --fill-hover: rgb(255 255 255 / 11%);
+    --hairline: rgb(255 255 255 / 14%);
+    --stroke: rgb(255 255 255 / 10%);
+    --edge: rgb(255 255 255 / 12%);
+    --track: #2b3747;
+    --solid: #161e28;
+    --solid-2: #1b2531;
+    --shadow-card: 0 8px 32px rgb(0 0 0 / 35%);
+    --shadow-pop: 0 18px 48px rgb(0 0 0 / 50%);
+    --shadow-thumb: 0 1px 4px rgb(0 0 0 / 40%);
+  }
+}
+
+@media (max-width: 1200px) { :root { --provider-columns: 2; } }
+@media (max-width: 850px)  { :root { --gutter: 20px; } }
+@media (max-width: 680px)  { :root { --provider-columns: 1; --gutter: 14px; } }
diff --git a/src/client/styles/usage.css b/src/client/styles/usage.css
new file mode 100644
index 0000000..604299e
--- /dev/null
+++ b/src/client/styles/usage.css
@@ -0,0 +1,100 @@
+/* ===== Overview: stats, trend chart, comparison, detail tables ===== */
+.dash-row { display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(300px, 1fr); gap: 16px; align-items: stretch; }
+
+/*
+ * usage-panel is a grid; .overview-card-header is display:contents so its children
+ * (stat-row, overview-toolbar) become grid items and the toolbar can sit on the chart title row:
+ *   [ stats ........................ ]
+ *   [ chart title ........ range · AGY ]
+ *   [ chart ......................... ]
+ */
+.usage-panel {
+  display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 16px; padding: 24px 28px;
+  grid-template-areas: "stats stats" "title tools" "chart chart" "axis axis";
+}
+.overview-card-header { display: contents; }
+
+.stat-row {
+  grid-area: stats; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 20px 28px;
+  margin-bottom: 22px; padding-bottom: 22px; border-bottom: 1px solid var(--edge);
+}
+.stat { min-width: 0; }
+.stat-label { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; color: var(--muted); font-size: 12.5px; }
+.stat-label .unit { margin: 0; }
+.stat strong { display: block; font-size: clamp(26px, 2.5vw, 34px); font-weight: 700; line-height: 1.15; letter-spacing: -.03em; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
+.stat strong .unit { font-weight: 400; }
+.stat small { display: block; margin-top: 4px; color: var(--muted); font-size: 12px; }
+
+.chart-heading { grid-area: title; margin: 0 0 6px; }
+.overview-toolbar { grid-area: tools; display: flex; align-items: center; gap: 8px; margin: 0 0 6px; }
+
+.ledger-filter { display: flex; align-items: center; gap: 2px; height: 38px; padding: 0 4px 0 14px; border-radius: var(--r-pill); }
+.ledger-filter label { color: var(--muted); font-size: 12px; white-space: nowrap; }
+.ledger-filter select { max-width: 200px; border-color: transparent; background-color: transparent; box-shadow: none; font-weight: 650; }
+.ledger-filter select:hover { background-color: var(--fill-hover); }
+
+/* AGY Claude toggle: a chip with a state dot. */
+.overview-toolbar > .comparison-tab-btn {
+  display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px;
+  border-radius: var(--r-pill); color: var(--muted); font-size: 12.5px; font-weight: 600; white-space: nowrap; cursor: pointer;
+}
+.overview-toolbar > .comparison-tab-btn::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--muted); opacity: .6; }
+.overview-toolbar > .comparison-tab-btn.active { color: var(--text); }
+.overview-toolbar > .comparison-tab-btn.active::before { background: var(--accent); opacity: 1; box-shadow: 0 0 0 3px var(--accent-soft); }
+
+/* Trend: pill bars on a faint 4-line grid. */
+.trend-chart {
+  grid-area: chart; position: relative; display: flex; align-items: flex-end; gap: 5px; height: 184px; padding: 36px 0 0;
+  background: repeating-linear-gradient(to top, transparent 0 calc(25% - 1px), var(--edge) calc(25% - 1px) 25%);
+  background-origin: content-box; background-clip: content-box;
+  border-bottom: 1px solid var(--edge);
+}
+.trend-col { flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; cursor: pointer; }
+.trend-bar {
+  width: 100%; max-width: 26px; border-radius: 8px 8px 3px 3px;
+  background: linear-gradient(180deg, var(--accent-hi), var(--accent));
+  transition: filter .18s var(--ease), box-shadow .18s var(--ease), height .5s var(--ease);
+}
+.trend-bar.is-empty { background: var(--track); }
+.trend-bar.is-hovered { filter: brightness(1.08); box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 60%, transparent); }
+.trend-tooltip {
+  position: absolute; top: 0; left: 50%; z-index: 2; transform: translateX(-50%);
+  display: flex; align-items: center; gap: 10px; padding: 4px 14px; border-radius: var(--r-pill);
+  font-size: 12px; font-variant-numeric: tabular-nums; white-space: nowrap; pointer-events: none;
+}
+.trend-axis { grid-area: axis; display: flex; justify-content: space-between; margin-top: 8px; color: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
+
+/* Comparison side panel. */
+.side-panel { display: flex; flex-direction: column; padding: 24px; }
+.model-comparison { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
+.comparison-controls > div { flex-wrap: wrap; gap: 8px; }
+.comparison-total { display: flex; align-items: baseline; gap: 8px; color: var(--muted); font-size: 12px; }
+.comparison-total > strong { margin-left: auto; color: var(--text); font-size: 28px; font-weight: 700; line-height: 1.15; letter-spacing: -.02em; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
+.comparison-list { overflow: auto; scrollbar-width: thin; }
+.comparison-list:focus-visible { border-radius: 8px; }
+.comparison-item + .comparison-item { margin-top: 16px; }
+.comparison-item-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 7px; font-size: 12.5px; }
+.comparison-model-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.comparison-model-value { flex: none; font-weight: 650; font-variant-numeric: tabular-nums; }
+.comparison-track { height: 6px; border-radius: 3px; background: var(--fill-inset); overflow: hidden; }
+.comparison-track > span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--accent), var(--accent-hi)); transition: width .5s var(--ease); }
+.comparison-empty { display: grid; place-items: center; min-height: 90px; color: var(--muted); font-size: 12.5px; }
+
+/* Detail tables. */
+.models-panel { padding: 20px 24px; }
+.table-scroll { overflow-x: auto; margin-top: 14px; border: 1px solid var(--edge); border-radius: var(--r-inner); background: var(--fill-inset); }
+.custom-table { width: 100%; min-width: 760px; font-size: 12.5px; text-align: left; }
+.custom-table th, .custom-table td { padding: 12px 14px; border-bottom: 1px solid var(--edge); vertical-align: middle; font-variant-numeric: tabular-nums; }
+.custom-table th { background: var(--fill-inset); color: var(--muted); font-size: 11.5px; font-weight: 600; white-space: nowrap; }
+.custom-table tbody tr:last-child td { border-bottom: 0; }
+.custom-table tbody tr { transition: background-color .15s var(--ease); }
+.custom-table tbody tr:hover { background: var(--fill-hover); }
+
+@media (max-width: 1000px) { .dash-row { grid-template-columns: 1fr; } }
+@media (max-width: 680px) {
+  .usage-panel { padding: 20px; grid-template-columns: 1fr; grid-template-areas: "stats" "title" "tools" "chart" "axis"; row-gap: 10px; }
+  .overview-toolbar { flex-wrap: wrap; }
+  .ledger-filter { flex: 1 1 100%; }
+  .ledger-filter select { flex: 1; max-width: none; }
+  .side-panel, .models-panel { padding: 20px; }
+}
